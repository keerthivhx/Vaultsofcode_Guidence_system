# VaultOfCode AI Support Chatbot Environment Variables

PORT=5000
NODE_ENV=development

# AI API Configuration (Optional: system works in dual-mode with smart RAG engine if key is absent)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Database URI (Optional: system falls back to in-memory store if absent)
MONGODB_URI=mongodb://localhost:27017/vaultofcode_chatbot

# Security & CORS
CLIENT_URL=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Support & Escalation Configuration
WHATSAPP_SUPPORT_NUMBER=+919876543210
SUPPORT_EMAIL=support@vaultofcode.com
